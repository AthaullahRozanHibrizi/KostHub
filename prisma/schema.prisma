// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      String     @default("pencari") // "pencari" or "pemilik"
  kosList   Kos[]
  reviews   Review[]
  favorites Favorite[]
  bookings  Booking[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Kos {
  id             String     @id @default(cuid())
  name           String
  price          Int
  type           String // "Putra", "Putri", "Campur"
  location       String
  description    String
  status         String     @default("Aktif") // "Aktif", "Penuh"
  totalRooms     Int        @default(1)
  availableRooms Int        @default(1)
  views          Int        @default(0)
  ownerId        String
  owner          User       @relation(fields: [ownerId], references: [id])
  images         KosImage[]
  facilities     Facility[]
  reviews        Review[]
  favorites      Favorite[]
  bookings       Booking[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model KosImage {
  id        String   @id @default(cuid())
  url       String
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Facility {
  id        String   @id @default(cuid())
  name      String
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([kosId, userId])
}

model Booking {
  id        String   @id @default(cuid())
  status    String   @default("PENDING") // PENDING, PAID, CANCELLED
  amount    Int
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
